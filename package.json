{
	"name": "n8n-nodes-blossom",
	"version": "3.0.8",
	"description": "n8n node for Blossom LMS/LXP integration - manage users, groups, memberships, and learning data",
	"license": "MIT",
	"homepage": "https://github.com/HirezRa/n8n-nodes-blossom",
	"keywords": [
		"n8n-community-node-package",
		"blossom",
		"lms",
		"lxp",
		"learning-management-system"
	],
	"author": {
		"name": "Hirez10"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HirezRa/n8n-nodes-blossom.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BlossomApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Blossom/Blossom.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^25.0.9",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"form-data": "^4.0.5"
	}
}
